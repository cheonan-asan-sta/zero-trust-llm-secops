ANALYZER_MODE=rule
APP_ENVIRONMENT=local
AUTH_MODE=disabled
# API_KEY_SHA256에는 실제 키가 아닌 SHA-256 16진수 해시만 저장합니다.
API_KEY_SHA256=
API_KEY_SUBJECT=service-client
API_KEY_TENANT_ID=local
API_KEY_ROLES=analyst,responder,viewer
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles
OIDC_TENANT_CLAIM=tenant_id
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
API_MAX_BODY_BYTES=1048576
ANALYSIS_MAX_CONCURRENCY=8
ANALYSIS_QUEUE_TIMEOUT_SECONDS=0.25
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY_SECRET_ARN=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_FEW_SHOT_COUNT=1
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=800
HYBRID_CONFIDENCE_THRESHOLD=0.85
HYBRID_LLM_TIMEOUT_SECONDS=2.5
AUDIT_LOG_PATH=runtime/audit.jsonl
CASE_LOG_PATH=runtime/cases.jsonl
OUTBOX_LOG_PATH=runtime/integration-outbox.jsonl
ZERO_TRUST_DB_PATH=runtime/zero-trust.sqlite3
# Optional; defaults to a separate *-behavior-context.sqlite3 beside the policy DB.
# BEHAVIOR_CONTEXT_DB_PATH=runtime/zero-trust-behavior-context.sqlite3
# Optional pinned public-key registry for local signed collector signals:
# TRUSTED_SIGNAL_SOURCES_PATH=runtime/local-collector/sources.json
SIGNAL_INBOX_MAX_PENDING=1000
SIGNAL_INBOX_MAX_RECORDS=10000
SIGNAL_INBOX_MAX_ATTEMPTS=3
SIGNAL_INBOX_LEASE_SECONDS=30
SIGNAL_INBOX_RETRY_SECONDS=1
AUDIT_BACKEND=jsonl
DYNAMODB_TABLE_NAME=zero-trust-llm-secops-audit
AWS_REGION=ap-northeast-2

# Legacy offline fixture ledger; the application response API uses the behavior context DB.
RESPONSE_WORKFLOW_DB_PATH=runtime/response-workflow.sqlite3
