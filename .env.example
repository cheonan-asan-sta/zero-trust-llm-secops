ANALYZER_MODE=rule
APP_ENVIRONMENT=local
AUTH_MODE=disabled
# Initial identity lookup per app/process (fixed at first use; restart to resize).
# Saturation returns503/Retry-After; disabled mode performs no identity I/O.
AUTHENTICATION_MAX_CONCURRENCY=4
AUTHENTICATION_QUEUE_TIMEOUT_SECONDS=0.05
AUTHENTICATION_MAX_TOKEN_CHARS=16384
# Optional local operations console. Requires local/test environment, authenticated
# admin, matching tenant, and a POSIX host with secure file locks. Keep this
# directory private (mode 0700), outside Git. Windows keeps host jobs disabled.
# DASHBOARD_OPERATIONS_DIRECTORY=runtime/dashboard-operations
# DASHBOARD_OPERATIONS_TENANT=local
# DASHBOARD_M7_PAIRED_DIRECTORY=runtime/path-to-verified-paired-bundle
# DASHBOARD_LIVE_MAX_USD=0
# API_KEY_SHA256에는 실제 키가 아닌 SHA-256 16진수 해시만 저장합니다.
API_KEY_SHA256=
API_KEY_SUBJECT=service-client
API_KEY_TENANT_ID=local
API_KEY_ROLES=analyst,responder,viewer
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles
OIDC_TENANT_CLAIM=tenant_id
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
API_MAX_BODY_BYTES=1048576
ANALYSIS_MAX_CONCURRENCY=8
ANALYSIS_QUEUE_TIMEOUT_SECONDS=0.25
# Per-process audit reads/reviews; saturation returns503/Retry-After.
AUDIT_QUERY_MAX_CONCURRENCY=2
AUDIT_QUERY_QUEUE_TIMEOUT_SECONDS=0.05
# Optional dedicated private32-byte key+pin for cursors shared across workers/restarts.
# Without both settings cursors are process-local and restart invalidates them.
# AUDIT_CURSOR_KEY_PATH=runtime/private/audit-cursor.key
# AUDIT_CURSOR_KEY_SHA256=<sha256 of the dedicated key>
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY_SECRET_ARN=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_PROMPT_MODE=legacy
OPENAI_FEW_SHOT_COUNT=1
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=800
# Optional: one retry only for an incomplete response caused by max_output_tokens.
# Adds a separately billed request. Must exceed OPENAI_MAX_OUTPUT_TOKENS.
OPENAI_INCOMPLETE_RETRIES=0
OPENAI_RETRY_MAX_OUTPUT_TOKENS=4000
# Optional read-only tool review; requires grounded mode and openai/hybrid mode.
# At most two bound evidence reads and three provider requests; no write tools.
OPENAI_EVIDENCE_AGENT_ENABLED=false
# Small verified execution bundles are given up front; history remains optional.
# on_request preserves explicit execution-tool retrieval for controlled comparison.
OPENAI_EVIDENCE_EXECUTION_DELIVERY=inline
# Total review deadline, shared by all provider/tool rounds (1-90 seconds).
OPENAI_EVIDENCE_REVIEW_TIMEOUT_SECONDS=30
HYBRID_CONFIDENCE_THRESHOLD=0.85
HYBRID_REVIEW_ALL=false
HYBRID_LLM_TIMEOUT_SECONDS=2.5
AUDIT_LOG_PATH=runtime/audit.jsonl
CASE_LOG_PATH=runtime/cases.jsonl
OUTBOX_LOG_PATH=runtime/integration-outbox.jsonl
ZERO_TRUST_DB_PATH=runtime/zero-trust.sqlite3
# Optional server-owned policy bundle; defaults to packaged demo resource policy.
# ZERO_TRUST_POLICY_PATH=runtime/local-remote-policy.json
# Optional; defaults to a separate *-behavior-context.sqlite3 beside the policy DB.
# BEHAVIOR_CONTEXT_DB_PATH=runtime/zero-trust-behavior-context.sqlite3
# Optional pinned public-key registry for local signed collector signals:
# TRUSTED_SIGNAL_SOURCES_PATH=runtime/local-collector/sources.json
SIGNAL_INBOX_MAX_PENDING=1000
SIGNAL_INBOX_MAX_RECORDS=10000
SIGNAL_INBOX_MAX_ATTEMPTS=3
SIGNAL_INBOX_LEASE_SECONDS=30
SIGNAL_INBOX_RETRY_SECONDS=1
AUDIT_BACKEND=jsonl
# Optional SQLite minimum-history guard. Requires an existing validated DB;
# capture a checkpoint first and keep its SHA-256 in a trusted separate record.
# AUDIT_DB_PATH=runtime/audit.sqlite3
# AUDIT_CHECKPOINT_PATH=runtime/private/audit-checkpoint.json
# AUDIT_CHECKPOINT_SHA256=<externally recorded checkpoint file sha256>
DYNAMODB_TABLE_NAME=zero-trust-llm-secops-audit
AWS_REGION=ap-northeast-2

# Legacy offline fixture ledger; the application response API uses the behavior context DB.
RESPONSE_WORKFLOW_DB_PATH=runtime/response-workflow.sqlite3
