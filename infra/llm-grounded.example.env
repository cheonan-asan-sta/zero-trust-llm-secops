# Optional analysis profile. Supply OPENAI_API_KEY through existing secret configuration.
# No permissions are granted by LLM output; conservative rule merging is retained.
ANALYZER_MODE=hybrid
OPENAI_PROMPT_MODE=grounded
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=2400
HYBRID_REVIEW_ALL=true
HYBRID_LLM_TIMEOUT_SECONDS=30
