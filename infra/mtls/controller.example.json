{
  "roots": ["/managed/gateway", "/managed/collector", "/managed/renewal"],
  "policies": ["/managed/gateway/profile.json", "/managed/collector/profile.json", "/managed/renewal/renew-gateway.json"],
  "extra_certificates": [],
  "allowed_provisioners": ["gateway-serverAuth", "collector-clientAuth", "renew-gateway-clientAuth"],
  "server_renewal": {"gateway": "renew-gateway"},
  "probes": [
    {
      "server_name": "gateway",
      "host": "gateway",
      "port": 8443,
      "profile": "/managed/collector/profile.json"
    }
  ],
  "reload_groups": [],
  "renew_before": {"gateway": 400, "collector": 400, "renew-gateway": 1200},
  "interval_seconds": 2,
  "overlap_seconds": 2,
  "disabled": [],
  "paused": false
}
