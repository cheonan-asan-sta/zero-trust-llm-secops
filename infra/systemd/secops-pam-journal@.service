[Unit]
Description=SecOps scoped PAM journal observations for %i
After=systemd-journald.service

[Service]
Type=oneshot
# Provision a dedicated account; this template does not create it.
User=secops-auth-collector
Group=secops-auth-collector
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/secops
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/secops/auth-journal/%i.conf
# Root's service manager reads one purpose-specific key into memory credentials.
LoadCredential=auth-journal-key:/run/secops-credential-provider/auth-%i.sock
ExecStart=/opt/secops/.venv/bin/python -m scripts.collect_pam_journal --tenant ${TENANT_ID} --server ${SERVER_ID} --unit %i.service --source ${AUTH_JOURNAL_SOURCE_ID} --key-id ${AUTH_JOURNAL_KEY_ID} --registry /etc/secops/service-registry.json --registry-sha256 ${SERVICE_REGISTRY_SHA256} --systemd-credential --lookback-seconds 60 --output /var/lib/secops-auth-journal-%i/${INVOCATION_ID}
StateDirectory=secops-auth-journal-%i
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryMax=256M
TasksMax=16
TimeoutStartSec=20
