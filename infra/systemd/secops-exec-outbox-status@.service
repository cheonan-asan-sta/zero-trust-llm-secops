[Unit]
Description=Recheck sealed execution outbox status for %i

[Service]
Type=oneshot
User=secops-collector
Group=secops-collector
EnvironmentFile=/etc/secops/exec-outbox/%i.conf
ExecStart=/opt/secops/.venv/bin/python -m scripts.exec_outbox_status --tenant ${OUTBOX_TENANT} --server ${OUTBOX_SERVER} --unit ${OUTBOX_UNIT} --source ${OUTBOX_SOURCE} --root /var/lib/secops-evidence/%i --outbox /var/lib/secops-outbox/%i --registry /etc/secops/service-registry.json --registry-sha256 ${SERVICE_REGISTRY_SHA256} --caller-registry /etc/secops/caller-registry.json --caller-registry-sha256 ${CALLER_REGISTRY_SHA256} --status-output /var/cache/secops-exec-outbox/%i.json
WorkingDirectory=/opt/secops
CacheDirectory=secops-exec-outbox
CacheDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/secops-evidence/%i/.capture-store.lock /var/lib/secops-outbox/%i/.capture-store.lock
CPUQuota=50%
MemoryMax=256M
TasksMax=8
TimeoutStartSec=20

# Optional template, never automatically installed/enabled. The registry and
# directories and 0600 lock files must be preprovisioned for the publisher's Unix owner; no private
# signing or recovery keys are loaded by this read-only evidence checker.
