[Unit]
Description=SecOps preapproved two-provider execution evidence for %i
After=systemd-journald.service

[Service]
Type=oneshot
User=secops-collector
Group=secops-collector
# Install the checkout/venv in /opt/secops; this template does not install it.
# Instance app observes app.service: secops-execution-collector@app.service
WorkingDirectory=/opt/secops
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/secops/collector-ha/%i.conf
# Two independently registered runtime-key providers, private to the collector UID.
# Install one collector writer per target; review profile SHA and both peer UIDs.
StandardInput=null
ExecStart=/opt/secops/.venv/bin/python -m scripts.collect_shared_execution --provider-profile /etc/secops/collector-providers/%i.json --provider-profile-sha256 ${PROVIDER_PROFILE_SHA256} --tenant ${TENANT_ID} --server ${SERVER_ID} --unit %i.service --source ${RUNTIME_SOURCE_ID} --key-id ${RUNTIME_KEY_ID} --registry /etc/secops/service-registry.json --registry-sha256 ${SERVICE_REGISTRY_SHA256} --output /var/lib/secops-evidence/%i/${INVOCATION_ID} --latest /var/lib/secops-evidence/%i/latest.json
StateDirectory=secops-evidence
StateDirectoryMode=0700
UMask=0077
PrivateNetwork=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX
PrivateDevices=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
MemoryMax=256M
TasksMax=16
TimeoutStartSec=20
