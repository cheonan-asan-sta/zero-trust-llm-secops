FROM python@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
ENV PYTHONDONTWRITEBYTECODE=1 ANALYZER_MODE=rule AUDIT_BACKEND=jsonl AUDIT_LOG_PATH=/tmp/audit.jsonl
WORKDIR /app
COPY infra/runtime/requirements/runtime.lock /requirements.lock
RUN python -m pip install --only-binary=:all: --require-hashes -r /requirements.lock && python -m pip check
COPY app ./app
COPY scripts ./scripts
USER 10001:10001
