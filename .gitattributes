# Replay fixture hashes are byte-exact and must remain stable across operating systems.
app/data/replay/** text eol=lf
app/data/benchmark/** text eol=lf
docs/benchmark-results/** text eol=lf
docs/infrastructure-results/** text eol=lf
infra/mtls/nginx-renewal.sh text eol=lf
infra/mtls/nginx-rekey.sh text eol=lf
infra/runtime/** text eol=lf
# Unified diff uses a single space for empty context lines.
infra/runtime/http-client.patch whitespace=-blank-at-eol

# M7 pilot integrity checks require the committed LF bytes.
infra/m7/pilot/*.jsonl text eol=lf
infra/m7/pilot/manifest.json text eol=lf
