# Replay fixture hashes are byte-exact and must remain stable across operating systems.
app/data/replay/** text eol=lf
app/data/benchmark/** text eol=lf
docs/benchmark-results/** text eol=lf
docs/infrastructure-results/** text eol=lf
infra/mtls/nginx-renewal.sh text eol=lf
infra/mtls/nginx-rekey.sh text eol=lf
infra/runtime/** text eol=lf
# Unified diff uses a single space for empty context lines.
infra/runtime/http-client.patch whitespace=-blank-at-eol

# M7 pilot integrity checks require the committed LF bytes.
infra/m7/pilot/*.jsonl text eol=lf
infra/m7/pilot/manifest.json text eol=lf

# F1 experiment contracts have external byte-exact anchors.
infra/f1-lab/** text eol=lf
# Keep historical model bytes (including one CRLF artifact) at their pinned SHA.
infra/f1-lab/frozen-vpn-protocol-v109/*.json -text whitespace=cr-at-eol
infra/f1-lab/frozen-vpn-control-v114/*.json -text whitespace=cr-at-eol
infra/f1-lab/frozen-audit-native-normal-v113/bundle.json -text whitespace=cr-at-eol
# Native audit records include the auditd GS separator and byte-exact anchors.
infra/f1-lab/native-audit/captured-v113/audit-native.source -text -diff
infra/f1-lab/native-audit/captured-v113/truth.jsonl -text
infra/f1-lab/native-audit/captured-v113/execution.json -text whitespace=cr-at-eol

# Historical approval evidence is pinned to the original committed bytes.
tests/fixtures/behavior_context/historical-approval.json text eol=lf
